# Backend environment (used for local development without Docker).
# In Docker, values come from the root .env file via docker-compose.yml.
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=educrm
DATABASE_USER=educrm
DATABASE_PASSWORD=change_me
DATABASE_LOGGING=false
DATABASE_RUN_MIGRATIONS=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=educrm:

JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# Rate limiting (per IP): requests per window (seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=120
