# Base URL of the API. Keep "/api" when the frontend is served behind the same origin
# (nginx in Docker, Vite dev proxy). Use a full URL only if the API lives on another domain.
VITE_API_URL=/api
VITE_APP_NAME=EduCRM

# Dev server only: where Vite proxies /api requests
VITE_PROXY_TARGET=http://localhost:3000
