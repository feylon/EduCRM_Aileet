# =============================================================================
#  EduCRM — environment for docker compose (copy to .env and adjust)
#  Never commit the real .env file.
# =============================================================================

# ---- Published ports on the host -------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=3000
# only used by docker-compose.dev.yml
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---- Application ------------------------------------------------------------
API_PREFIX=api
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SWAGGER_ENABLED=true
# Create demo data on startup (idempotent). Set to false in real production.
RUN_SEED=true
# Base URL the frontend uses for API calls. Keep "/api" (proxied by nginx).
API_URL=/api
SHOW_DEMO_ACCOUNTS=true

# ---- PostgreSQL -------------------------------------------------------------
# Inside docker the host is the service name "postgres" (set in docker-compose.yml)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=educrm
DATABASE_USER=educrm
DATABASE_PASSWORD=change_me_postgres_password
DATABASE_LOGGING=false

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=educrm:

# ---- JWT (use long random strings, e.g. `openssl rand -hex 32`) -------------
JWT_SECRET=change_me_access_secret_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# ---- Security ----------------------------------------------------------------
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
THROTTLE_TTL=60
THROTTLE_LIMIT=120
